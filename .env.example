# Copy to .env and fill in. Never commit .env.

# --- Required: GitHub App (Settings → Your App → General) ---
GITHUB_APP_ID=123456
# Full PEM with literal \n escapes, quoted:
# GITHUB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMII...\n-----END RSA PRIVATE KEY-----"
GITHUB_PRIVATE_KEY=__PASTE_ESCAPED_PEM_HERE__
GITHUB_WEBHOOK_SECRET=__openssl_rand_hex_32__

# --- Optional ---
# Mention replies (Track 3 / N2+N3): bot identity for @mention detection +
# self-reply loop prevention on the channel adapter route
# /api/agents/code-review-agent/channels/github/webhook.
# GITHUB_BOT_USERNAME=e.g. xcodesheriff-bot[bot]
# GITHUB_BOT_USER_ID=numeric id of the …[bot] user
#   curl -s 'https://api.github.com/users/<name>%5Bbot%5D' | grep '"id"'
GITHUB_BOT_USERNAME=
GITHUB_BOT_USER_ID=
# Studio manual-run fallback (trailing number of /settings/installations/<id>).
# Webhooks carry the real installation.id, so this is only needed for Studio tests.
GITHUB_INSTALLATION_ID=
# Queue (defaults to redis://localhost:6379; webhook degrades to queued:false if down).
REDIS_URL=redis://localhost:6379

# --- Models (no OpenAI) ---
# Agents: nvidia/meta/muse-glimmer-30b → ollama-cloud/gpt-oss:120b fallback.
# Observer: ollama-cloud/gpt-oss:120b. Provider credentials live wherever
# your model gateway expects them.
